meta {
  name: Materias
  type: http
  seq: 1
}

get {
  url: {{sysacadUrl}}/api/data/views/Materias
  body: none
  auth: none
}

params:query {
  ~ESPECIALID: 1
  ~plan: 1
  ~materia: 1
  ~MateriaNombre: value
  ~sort: MateriaNombre
  ~direction: asc
}

docs {
  Consulta directa a la vista Materias de Sysacad. Columnas usadas por el backend:
  ESPECIALID, plan, materia, MateriaNombre. Los filtros van como query params por
  nombre de columna; el orden con sort y direction (asc|desc).
}
