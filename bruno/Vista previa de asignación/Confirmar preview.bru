meta {
  name: Confirmar preview
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/previews/:previewId/confirm
  body: json
  auth: bearer
}

params:path {
  previewId: prev_961560f8
}

auth:bearer {
  token: eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJhZG1pbkBmcmMudXRuLmVkdS5hciIsInJvbGVzIjpbIlNVQlNFQ1JFVEFSSUEiXSwiaWF0IjoxNzg1MTE0NTc1LCJleHAiOjE3ODUxMTU3NzV9.X-EjQOMqzdQbdcABQ3BubqKjeZHNDvvuohGpXe1eGu3uN9Oifsl_FojTuPEDvWLS
