meta {
  name: Importar Excel
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/excelimports
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/Users/mateoblencio/Downloads/planilla-example.xlsx) @contentType(application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)
}

settings {
  encodeUrl: true
  timeout: 0
}
