meta {
  name: Asignar aula a ocurrencia
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/allocations/occurrences/14001
  body: json
  auth: none
}

body:json {
  {
    "classroomId": 85,
    "observation": "prueba"
  }
}

docs {
  Asigna un aula a una ocurrencia puntual (source = MANUAL).

  Valida que el aula no esté ya ocupada (asignación ASSIGNED existente de OTRO
  evento) en la misma fecha/franja horaria de la ocurrencia. Si hay solapamiento →
  409 con:
  {
    "conflicts": [
      { "occurrenceId", "date", "startTime", "endTime", "classroomId",
        "conflictingEventId", "conflictingAllocationId" }
    ]
  }
}
