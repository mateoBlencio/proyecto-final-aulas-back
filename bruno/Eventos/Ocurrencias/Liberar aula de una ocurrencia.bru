meta {
  name: Liberar aula de una ocurrencia (deprecado)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/events/occurrences/:occurrenceId/release
  body: none
  auth: inherit
}

params:path {
  occurrenceId: 1
}

docs {
  DEPRECADO: usar POST /v1/allocations/releases. Marca la ocurrencia como ROOM_RELEASED (libera el aula a propósito, reasignable en cualquier momento). Rechaza ocurrencias pasadas.
}
