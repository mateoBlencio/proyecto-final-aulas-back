meta {
  name: Importar Excel
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/imports
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(H:\Users\Matias\Desktop\planilla-example.xlsx) @contentType(application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)
}

settings {
  encodeUrl: true
  timeout: 0
}
