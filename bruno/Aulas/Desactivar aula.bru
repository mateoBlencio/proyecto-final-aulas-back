meta {
  name: Desactivar aula
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/classrooms/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

assert {
  res.status: eq 200
  res.body.releasedClasses: isNumber
  res.body.mergedClasses: isNumber
  res.body.affectedRoomRequests: isNumber
  res.body.visibleRoomRequests: isArray
}

docs {
  DELETE /v1/classrooms/{id}/activation. Roles: ADMINISTRADOR, AUXILIAR_AULICO
  (acotado a sus edificios). Soft-delete idempotente. Libera las clases futuras asignadas
  al aula (releaseReason CLASSROOM_DEACTIVATED, nota "Aula deshabilitada") y fusiona las que
  tienen espejo en otra aula. 404 si el aula no existe.

  Respuesta 200 (antes 204), siempre con cuerpo:
  { releasedClasses, mergedClasses, affectedRoomRequests,
    visibleRoomRequests: [ { itemId, requestId, status, teacherName, subjectName, classroomIds } ] }
  Repetir la baja devuelve 0 y 0.
}
