meta {
  name: Desactivar aula
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/classrooms/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  DELETE /v1/classrooms/{id}/activation. Roles: SUBSECRETARIA, AUXILIAR_AULICO
  (acotado a sus edificios). Soft-delete idempotente. 204 si queda inactiva;
  404 si el aula no existe.
}
