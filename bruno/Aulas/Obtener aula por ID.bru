meta {
  name: Obtener aula por ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/classrooms/85
  body: none
  auth: inherit
}

docs {
  GET /v1/classrooms/{id}. Permiso: PERM_CLASSROOM_READ.
  Responde aunque el aula o su edificio esten dados de baja o no vigentes; unavailableReason explica por que no se ofrece.
}
