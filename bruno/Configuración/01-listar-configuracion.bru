meta {
  name: Listar configuración
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/settings
  body: none
  auth: inherit
}

docs {
  Devuelve la configuración de negocio parametrizable agrupada por categoría
  (optimizer, preview, events, allocation), con su metadata: tipo, valor
  actual, valor por defecto, nivel de riesgo y cotas (min/max). Requiere rol
  SUBSECRETARIA.
}
