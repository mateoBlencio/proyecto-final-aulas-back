meta {
  name: Listar materia-comisión
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/subject-commissions?subjectId=1&includeDeactivated=false
  body: none
  auth: inherit
}

params:query {
  subjectId: 1
  includeDeactivated: false
}

docs {
  Sin subjectId devuelve el catálogo completo materia×comisión. Con subjectId,
  filtra las comisiones vinculadas a esa materia (no valida que la materia exista:
  id inexistente devuelve lista vacía).
}
