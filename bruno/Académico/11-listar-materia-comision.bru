meta {
  name: Listar materia-comisión
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/subject-commissions?page=0&size=20&subjectId=1&includeDeactivated=false
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
  subjectId: 1
  ~commissionId: 2
  includeDeactivated: false
}

docs {
  Listado paginado. Filtros opcionales: subjectId, commissionId. La respuesta es
  { content: [...], page: { size, number, totalElements, totalPages } }.
  sort por defecto id.subjectId.
}
