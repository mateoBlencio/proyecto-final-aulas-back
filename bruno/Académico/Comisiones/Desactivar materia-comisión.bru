meta {
  name: Desactivar materia-comisión
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/subject-commissions/:subjectId/:commissionId/activation
  body: none
  auth: inherit
}

params:path {
  subjectId: 1
  commissionId: 1
}

docs {
  DELETE /v1/subject-commissions/{subjectId}/{commissionId}/activation. Rol: SUBSECRETARIA.
  Soft-delete idempotente. 204 si queda inactivo; 404 si el vínculo no existe.
}
