meta {
  name: Desactivar comisión
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/commissions/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  DELETE /v1/commissions/{id}/activation. Rol: SUBSECRETARIA.
  Soft-delete idempotente. 204 si queda inactiva; 404 si la comisión no existe.
}
