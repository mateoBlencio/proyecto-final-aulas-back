meta {
  name: Desactivar materia
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/subjects/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  DELETE /v1/subjects/{id}/activation. Rol: SUBSECRETARIA.
  Soft-delete idempotente. 204 si queda inactiva; 404 si la materia no existe.
}
