meta {
  name: Activar materia
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/subjects/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  PUT /v1/subjects/{id}/activation. Rol: SUBSECRETARIA.
  Reactiva una materia desactivada (idempotente). 204 si queda activa;
  404 si la materia no existe.
}
