meta {
  name: Obtener materia por ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/subjects/:id
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  GET /v1/subjects/{id}. Responde 404 si la materia esta dada de baja o su plan de
  estudio esta dado de baja. Para ver esas materias y su unavailableReason, usar
  el listado con includeDeactivated=true.
}
