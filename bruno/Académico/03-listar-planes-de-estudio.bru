meta {
  name: Listar planes de estudio
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/study-plans?page=0&size=20&includeDeactivated=false
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
  ~planCode: 94
  ~specialtyCode: 17
  includeDeactivated: false
}

docs {
  Listado paginado. Filtros opcionales: planCode, specialtyCode. La respuesta es
  { content: [...], page: { size, number, totalElements, totalPages } }.
}
