meta {
  name: Desactivar período académico
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/v1/academic-periods/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  DELETE /v1/academic-periods/{id}/activation. Rol: SUBSECRETARIA.
  Soft-delete idempotente. 204 si queda inactivo; 404 si el período no existe.
}
