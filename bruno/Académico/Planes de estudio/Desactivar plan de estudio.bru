meta {
  name: Desactivar plan de estudio
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/study-plans/:id/activation
  body: none
  auth: inherit
}

params:path {
  id: 1
}

docs {
  DELETE /v1/study-plans/{id}/activation. Rol: SUBSECRETARIA.
  Soft-delete idempotente. 204 si queda inactivo; 404 si el plan no existe.
}
