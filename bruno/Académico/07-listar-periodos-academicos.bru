meta {
  name: Listar períodos académicos
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/academic-periods?page=0&size=20&includeDeactivated=false
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
  ~year: 2026
  ~semester: 0
  includeDeactivated: false
}

docs {
  Listado paginado. Filtros opcionales: year, semester. La respuesta es
  { content: [...], page: { size, number, totalElements, totalPages } }.
}
