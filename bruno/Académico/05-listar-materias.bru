meta {
  name: Listar materias
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/subjects?page=0&size=20&specialtyCode=5&includeDeactivated=false
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
  ~code: 101
  ~name: algoritmos
  specialtyCode: 5
  ~studyPlanId: 1
  includeDeactivated: false
}

docs {
  Listado paginado. Filtros opcionales: code, name (contiene, case-insensitive),
  specialtyCode, studyPlanId. La respuesta es
  { content: [...], page: { size, number, totalElements, totalPages } }.
}
