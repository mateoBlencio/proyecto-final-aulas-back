      "name": "headroom",
      "command": "headroom",
      "onlyIfPlugin": "headroom@headroom-marketplace",
      "usedBy": "hooks del plugin headroom (SessionStart y cada Bash)",
      "install": "python3 -m venv ~/.local/share/headroom/venv && ~/.local/share/headroom/venv/bin/pip install \"headroom-ai[all]\" && ln -sf ~/.local/share/headroom/venv/bin/headroom ~/.local/bin/headroom  (o con uv: uv tool install --python 3.13 \"headroom-ai[all]\"; ocupa ~7 GB)"
    }
