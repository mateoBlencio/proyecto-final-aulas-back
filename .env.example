# =============================================================
# PERFIL ACTIVO - dev | test | prod
# =============================================================
SPRING_PROFILES_ACTIVE=dev

# =============================================================
# BASE DE DATOS
# =============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siga
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# =============================================================
# SEGURIDAD (JWT)
# =============================================================
# Los perfiles dev-local y dev-snapshot generan uno aleatorio por arranque si queda vacío.
JWT_SECRET=
JWT_ISSUER=siga
# Recomendado: un JWT_AUDIENCE distinto por entorno, así un token de dev no vale en test
JWT_AUDIENCE=siga-api
JWT_ACCESS_EXPIRATION_MINUTES=20
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_REFRESH_GRACE_SECONDS=10

# Dominio de correo institucional permitido para login/registro
AUTH_ALLOWED_EMAIL_DOMAIN=frc.utn.edu.ar

# =============================================================
# CORREO
# El perfil dev-local (Docker Compose de Spring Boot) sigue usando MailHog
# fijo en application-dev-local.yaml, sin vars acá.
# El deploy compartido (docker-compose.deploy.yml, perfil dev) manda por
# Gmail SMTP: ver MAIL_HOST_DEV/MAIL_USERNAME_DEV/MAIL_PASSWORD_DEV/
# MAIL_FROM_DEV más abajo, en la sección de despliegue Docker.
# =============================================================

# =============================================================
# CORS
# Lista de orígenes permitidos separados por coma.
# =============================================================
CORS_ALLOWED_ORIGINS=

# =============================================================
# REVERSE PROXY (IP real del cliente)
# Regex con la IP del proxy que está delante del backend (ej. 172\.18\.0\.5 o
# 10\.0\.0\.\d+). Solo si el peer TCP directo coincide, el backend toma la IP
# del cliente de X-Forwarded-For (rate limit y logs). Vacío = no se confía en
# ningún proxy y el header se ignora (todos los clientes comparten la IP del proxy).
# El proxy (nginx) debe: setear X-Forwarded-For con proxy_set_header
# X-Forwarded-For $remote_addr (o $proxy_add_x_forwarded_for, que agrega al final) y
# NO reenviar tal cual el X-Forwarded-For que mande el cliente. El backend toma la
# entrada más a la derecha que no sea un proxy confiable; no exponer el puerto del
# backend a clientes sin pasar por el proxy.
# =============================================================
# OBLIGATORIO en dev, test y prod: con el valor vacío el backend arranca con un WARN y el
# rate limit por IP (login: 200 fallos/15 min, configurable) corta a toda la institución junta.
TRUSTED_PROXIES=

# =============================================================
# INTEGRACIÓN SYSACAD (data-view UTN FRC) — ver plans/const/api-sysacad.md
# Requeridas (sin default). Compartidas entre perfiles dev y test.
# SYSACAD_ENABLED=true arranca los cron semanales de sync contra la API real.
# =============================================================
SYSACAD_ENABLED=false
SYSACAD_API_KEY=

# Archivado semanal de auditoría anterior al ciclo previo (schema archivo). Default: false; prod: true.
# AUDIT_ARCHIVE_ENABLED=false

# =============================================================
# DESPLIEGUE DOCKER (docker-compose.deploy.yml)
# =============================================================
BACK_USER_DEV_PASSWORD=
BACK_USER_TEST_PASSWORD=

# Usuario de migraciones (Flyway).
MIGRATION_USER_DEV_PASSWORD=
MIGRATION_USER_TEST_PASSWORD=
JWT_SECRET_DEV=
JWT_SECRET_TEST=
# Audiencia por entorno del deploy compartido (default siga-api); usar valores distintos
JWT_AUDIENCE_DEV=siga-api-dev
JWT_AUDIENCE_TEST=siga-api-test
CORS_ALLOWED_ORIGINS_DEV=
CORS_ALLOWED_ORIGINS_TEST=

# Gmail SMTP para el perfil dev (smtp.gmail.com:587, ya default en
# application.yaml). MAIL_USERNAME_DEV es la cuenta de Gmail completa,
# MAIL_PASSWORD_DEV es una App Password (myaccount.google.com > Seguridad >
# Contraseñas de aplicaciones; requiere verificación en dos pasos activada).
# MAIL_FROM_DEV debe coincidir con MAIL_USERNAME_DEV: Gmail rechaza/reescribe
# el From si no coincide con la cuenta autenticada.
MAIL_HOST_DEV=smtp.gmail.com
MAIL_USERNAME_DEV=
MAIL_PASSWORD_DEV=
MAIL_FROM_DEV=

# Topología de base de datos por perfil
DB_HOST_DEV=postgres_dev
DB_NAME_DEV=database_dev
DB_USERNAME_DEV=back_user_dev
DB_MIGRATION_USERNAME_DEV=migration_user_dev
DB_HOST_TEST=postgres_test
DB_NAME_TEST=database_test
DB_USERNAME_TEST=back_user_test
DB_MIGRATION_USERNAME_TEST=migration_user_test

# scripts/dev-snapshot.sh refresh: acceso de lectura a la base de dev (no se versiona el host)
DEV_SNAPSHOT_ADMIN_HOST=
DEV_SNAPSHOT_ADMIN_USER=
# DEV_SNAPSHOT_ADMIN_DB=database_dev

# =============================================================
# CONTEO POR CÁMARAS (servicio aparte, repo proyecto-final-aulas-conteo)
# CONTEO_API_KEY_DEV / _TEST tienen que coincidir con el environment secret
# CONTEO_API_KEY del entorno dev/test de ese repo, que es donde vive la clave del
# lado del servicio. Acá, en el .env de ESTE backend en el server, va la copia que
# el backend manda en el header X-API-Key. Sin default: si falta o está vacía, el
# CD corta el deploy en "Check env file".
# El backend desplegado llega al conteo por la red interna de Docker; para correrlo
# en la máquina de desarrollo hay que apuntar CONTEO_URL al proxy del server, ver
# plans/conteo-camaras/despliegue-camaras.md.
# CONTEO_TIMEOUT_SEG=90: el servicio tarda hasta 75 s en el peor caso (30 s de cola
# de inferencia + 45 s de conteo), así que 60 cortaría antes que el servicio.
# =============================================================
# Obligatoria y sin default, igual que SYSACAD_ENABLED: false acá; true en el .env del server.
CONTEO_ENABLED=false
# Solo con CONTEO_ENABLED=true en la máquina de desarrollo: proxy del server por Tailscale
# (http://100.90.179.1:8092) o conteo local (http://127.0.0.1:8000, clave-local).
# CONTEO_URL=
# CONTEO_API_KEY=
CONTEO_API_KEY_DEV=
CONTEO_API_KEY_TEST=
CONTEO_TIMEOUT_SEG=90
