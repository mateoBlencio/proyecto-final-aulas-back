# =============================================================
# PERFIL ACTIVO - dev | test | prod
# =============================================================
SPRING_PROFILES_ACTIVE=dev

# =============================================================
# BASE DE DATOS
# =============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siga
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# =============================================================
# SEGURIDAD (JWT)
# =============================================================
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=20
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_REFRESH_GRACE_SECONDS=10

# Dominio de correo institucional permitido para login/registro
AUTH_ALLOWED_EMAIL_DOMAIN=frc.utn.edu.ar

# =============================================================
# CORREO
# El perfil dev-local (Docker Compose de Spring Boot) sigue usando MailHog
# fijo en application-dev-local.yaml, sin vars acá.
# El deploy compartido (docker-compose.deploy.yml, perfil dev) manda por
# Gmail SMTP: ver MAIL_HOST_DEV/MAIL_USERNAME_DEV/MAIL_PASSWORD_DEV/
# MAIL_FROM_DEV más abajo, en la sección de despliegue Docker.
# =============================================================

# =============================================================
# CORS
# Lista de orígenes permitidos separados por coma.
# =============================================================
CORS_ALLOWED_ORIGINS=

# =============================================================
# INTEGRACIÓN SYSACAD (data-view UTN FRC) — ver plans/const/api-sysacad.md
# Requeridas (sin default). Compartidas entre perfiles dev y test.
# SYSACAD_ENABLED=true arranca los cron semanales de sync contra la API real.
# =============================================================
SYSACAD_ENABLED=false
SYSACAD_API_KEY=

# =============================================================
# DESPLIEGUE DOCKER (docker-compose.deploy.yml)
# =============================================================
BACK_USER_DEV_PASSWORD=
BACK_USER_TEST_PASSWORD=

# Usuario de migraciones (Flyway).
MIGRATION_USER_DEV_PASSWORD=
MIGRATION_USER_TEST_PASSWORD=
JWT_SECRET_DEV=
JWT_SECRET_TEST=
CORS_ALLOWED_ORIGINS_DEV=
CORS_ALLOWED_ORIGINS_TEST=

# Gmail SMTP para el perfil dev (smtp.gmail.com:587, ya default en
# application.yaml). MAIL_USERNAME_DEV es la cuenta de Gmail completa,
# MAIL_PASSWORD_DEV es una App Password (myaccount.google.com > Seguridad >
# Contraseñas de aplicaciones; requiere verificación en dos pasos activada).
# MAIL_FROM_DEV debe coincidir con MAIL_USERNAME_DEV: Gmail rechaza/reescribe
# el From si no coincide con la cuenta autenticada.
MAIL_HOST_DEV=smtp.gmail.com
MAIL_USERNAME_DEV=
MAIL_PASSWORD_DEV=
MAIL_FROM_DEV=

# Topología de base de datos por perfil
DB_HOST_DEV=postgres_dev
DB_NAME_DEV=database_dev
DB_USERNAME_DEV=back_user_dev
DB_MIGRATION_USERNAME_DEV=migration_user_dev
DB_HOST_TEST=postgres_test
DB_NAME_TEST=database_test
DB_USERNAME_TEST=back_user_test
DB_MIGRATION_USERNAME_TEST=migration_user_test
