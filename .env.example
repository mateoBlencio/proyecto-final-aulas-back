# =============================================================
# PERFIL ACTIVO - dev | test | prod
# =============================================================
SPRING_PROFILES_ACTIVE=dev

# =============================================================
# BASE DE DATOS
# =============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siga
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# =============================================================
# SEGURIDAD (JWT)
# =============================================================
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=20
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_REFRESH_GRACE_SECONDS=10

# =============================================================
# DESPLIEGUE DOCKER (docker-compose.deploy.yml)
# Copiar estos valores al .env real en el servidor
# =============================================================
BACK_USER_DEV_PASSWORD=
BACK_USER_TEST_USERNAME=
BACK_USER_TEST_PASSWORD=
